# Maintainer: Bruno Goncalves <bigbruno@gmail.com>

pkgname=auto-rules-io
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('x86_64' 'aarch64')
license=('GPL')
url="https://github.com/biglinux/auto-rules-io"
pkgdesc="BigLinux I/O, memory and boot tuning"
source=("git+https://github.com/biglinux/auto-rules-io.git")
depends=("bash" "glibc" "libgcc" "systemd")
makedepends=("git" "cargo")
md5sums=(SKIP)
install=auto-rules-io.install

prepare() {
    cd "${srcdir}/${pkgname}/deskbalance"
    cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
    cd "${srcdir}/${pkgname}/deskbalance"
    export CARGO_INCREMENTAL=0 CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd "${srcdir}/${pkgname}/deskbalance"
    export CARGO_INCREMENTAL=0 CARGO_TARGET_DIR=target
    cargo test --frozen
}

package() {
    # Verify default folder
    if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
        InternalDir="${srcdir}/${pkgname}/${pkgname}"
    else
        InternalDir="${srcdir}/${pkgname}"
    fi


    # Copy files
    if [ -d "${InternalDir}/usr" ]; then
        cp -r "${InternalDir}/usr" "${pkgdir}/"
    fi

    if [ -d "${InternalDir}/etc" ]; then
        cp -r "${InternalDir}/etc" "${pkgdir}/"
    fi

    if [ -d "${InternalDir}/opt" ]; then
        cp -r "${InternalDir}/opt" "${pkgdir}/"
    fi

    install -Dm755 "${srcdir}/${pkgname}/deskbalance/target/release/deskbalance" "${pkgdir}/usr/bin/deskbalance"
}
